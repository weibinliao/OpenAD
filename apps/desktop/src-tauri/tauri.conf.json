{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build:static",
    "beforeDevCommand": "npm --prefix ../web run dev -- --port 3010",
    "devPath": "http://localhost:3010",
    "distDir": "../../web/out"
  },
  "package": {
    "productName": "OpenAD",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["**"]
      },
      "dialog": {
        "all": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "systemTray": {
        "all": true
      }
    },
    "bundle": {
      "active": false,
      "targets": "all",
      "identifier": "io.openad.app",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "OpenAD",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}
