COMPOSE_PROJECT_NAME=permission-protector
APP_ENV=development
# Replace every value marked replace-with-* before enabling a backing service.
APP_HOST=127.0.0.1
API_PORT=18080
WEB_PORT=3010
POSTGRES_PORT=5432
POSTGRES_DB=permission_protector
POSTGRES_USER=permission_protector
POSTGRES_PASSWORD=replace-with-a-strong-random-password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=permission_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-a-strong-random-password
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-random-password
PERMISSION_PROTECTOR_DATA_DIR=
OPENAD_SCAN_ROOT=
DATABASE_URL=
